HOST=0.0.0.0
PORT=8080
# Choose one persistent store. Docker Compose overrides DATABASE_URL.
DATABASE_URL=postgres://installer:replace-with-a-random-password@postgres:5432/installer
# Windows single-server deployment can use:
# SQLITE_PATH=C:\ai-tool-installer\.data\license.sqlite3
USE_MEMORY_STORE=false
ADMIN_TOKEN=replace-with-at-least-32-random-characters
CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
LICENSE_PRIVATE_KEY_PATH=/run/secrets/license-private.pem
LICENSE_KEY_ID=license-v1
LICENSE_TTL_DAYS=30
# 反向代理与 API 之间只有一跳时设为 1。
TRUST_PROXY_HOPS=1
MAX_UPLOAD_BYTES=536870912

# 公网 API 禁止持有清单私钥和 OSS 写凭据。安装源请通过本地管理 CLI 发布。
SOURCE_MANAGEMENT_ENABLED=false
MANIFEST_KEY_ID=manifest-v1
