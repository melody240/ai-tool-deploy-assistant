MANIFEST_PATH=./release/source-manifest.signed.json
MANIFEST_HISTORY_DIR=./release/history
MANIFEST_PRIVATE_KEY=./.secrets/manifest-private.pem
MANIFEST_PUBLIC_KEY=./.secrets/manifest-public.pem
MANIFEST_KEY_ID=manifest-v1

# Connect through: ssh -N -L 8080:127.0.0.1:8080 user@your-server
ADMIN_API_URL=http://127.0.0.1:8080
ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Aliyun OSS through its S3-compatible endpoint.
STORAGE_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
STORAGE_REGION=cn-hangzhou
STORAGE_BUCKET=replace-with-your-bucket
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_PUBLIC_BASE_URL=https://replace-with-your-bucket.oss-cn-hangzhou.aliyuncs.com
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MANIFEST_KEY=manifests/source-manifest.json
STORAGE_UPDATER_KEY=updates/latest.json
